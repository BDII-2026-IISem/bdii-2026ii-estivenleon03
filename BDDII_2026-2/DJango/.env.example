# Copy this file to .env and replace the placeholders before starting Django.
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Use the existing MySQL database; do not change these values without verifying
# the target database and its data first.
DB_ENGINE=django.db.backends.mysql
DB_NAME=huellavet_db
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_HOST=127.0.0.1
DB_PORT=3306

# Restrict browser requests to the local Angular development server by default.
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
